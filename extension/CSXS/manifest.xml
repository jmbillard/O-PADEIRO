<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jmbillard.opadeiro" ExtensionBundleVersion="2.0.1"
	ExtensionBundleName="O PADEIRO" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<ExtensionList>
		<Extension Id="com.jmbillard.opadeiro.bar" Version="2.0.1" />
		<Extension Id="com.jmbillard.opadeiro.panel" Version="2.0.1" />
		<Extension Id="com.jmbillard.opadeiro.finder" Version="2.0.1" />
		<Extension Id="com.jmbillard.opadeiro.converter" Version="2.0.1" />
		<Extension Id="com.jmbillard.opadeiro.productions" Version="2.0.1" />
		<Extension Id="com.jmbillard.opadeiro.maker" Version="2.0.1" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="[22.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="7.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>

	<DispatchInfoList>
		<!-- barra principal -->
		<Extension Id="com.jmbillard.opadeiro.bar">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/bar.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>O PADEIRO</Menu>
					<Geometry>
						<Size>
							<Width>640</Width>
							<Height>84</Height>
						</Size>
						<MinSize>
							<Width>56</Width>
							<Height>56</Height>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>

		<!-- painel de templates -->
		<Extension Id="com.jmbillard.opadeiro.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/index.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Menu>O PADEIRO templates</Menu>
					<Geometry>
						<Size>
							<Width>460</Width>
							<Height>760</Height>
						</Size>
						<MinSize>
							<Width>340</Width>
							<Height>480</Height>
						</MinSize>
						<MaxSize>
							<Width>4000</Width>
							<Height>3000</Height>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- O ACESSORISTA: busca de caminhos e de textos -->
		<Extension Id="com.jmbillard.opadeiro.finder">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/finder.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Menu>O ACESSORISTA</Menu>
					<Geometry>
						<Size>
							<Width>720</Width>
							<Height>290</Height>
						</Size>
						<MinSize>
							<Width>300</Width>
							<Height>220</Height>
						</MinSize>
						<MaxSize>
							<Width>4000</Width>
							<Height>3000</Height>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- conversor de caminhos Windows / macOS -->
		<Extension Id="com.jmbillard.opadeiro.converter">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/converter.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Menu>O PADEIRO conversor</Menu>
					<Geometry>
						<Size>
							<Width>800</Width>
							<Height>214</Height>
						</Size>
						<MinSize>
							<Width>300</Width>
							<Height>214</Height>
						</MinSize>
						<MaxSize>
							<Width>4000</Width>
							<Height>214</Height>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- lista de produções (editor) -->
		<Extension Id="com.jmbillard.opadeiro.productions">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/productions.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Menu>O PADEIRO produções</Menu>
					<Geometry>
						<Size>
							<Width>860</Width>
							<Height>520</Height>
						</Size>
						<MinSize>
							<Width>320</Width>
							<Height>320</Height>
						</MinSize>
						<MaxSize>
							<Width>4000</Width>
							<Height>3000</Height>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- criador de templates -->
		<Extension Id="com.jmbillard.opadeiro.maker">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/maker.html</MainPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Menu>O PADEIRO criar template</Menu>
					<Geometry>
						<Size>
							<Width>980</Width>
							<Height>780</Height>
						</Size>
						<MinSize>
							<Width>340</Width>
							<Height>420</Height>
						</MinSize>
						<MaxSize>
							<Width>4000</Width>
							<Height>3000</Height>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
