<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jmbillard.opadeiro" ExtensionBundleVersion="0.1.0"
	ExtensionBundleName="O PADEIRO" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<ExtensionList>
		<Extension Id="com.jmbillard.opadeiro.bar" Version="0.1.0" />
		<Extension Id="com.jmbillard.opadeiro.panel" Version="0.1.0" />
		<Extension Id="com.jmbillard.opadeiro.finder" Version="0.1.0" />
		<Extension Id="com.jmbillard.opadeiro.converter" Version="0.1.0" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="[22.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="11.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>

	<DispatchInfoList>
		<!-- barra principal -->
		<Extension Id="com.jmbillard.opadeiro.bar">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/bar.html</MainPath>
					<ScriptPath>./host/index.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>O PADEIRO</Menu>
					<Geometry>
						<Size>
							<Width>640</Width>
							<Height>84</Height>
						</Size>
						<MinSize>
							<Width>56</Width>
							<Height>56</Height>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>

		<!-- painel de templates -->
		<Extension Id="com.jmbillard.opadeiro.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/index.html</MainPath>
					<ScriptPath>./host/index.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>O PADEIRO templates</Menu>
					<Geometry>
						<Size>
							<Width>560</Width>
							<Height>760</Height>
						</Size>
						<MinSize>
							<Width>340</Width>
							<Height>480</Height>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- O ACESSORISTA: busca de caminhos e de textos -->
		<Extension Id="com.jmbillard.opadeiro.finder">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/finder.html</MainPath>
					<ScriptPath>./host/index.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>O ACESSORISTA</Menu>
					<Geometry>
						<Size>
							<Width>520</Width>
							<Height>720</Height>
						</Size>
						<MinSize>
							<Width>300</Width>
							<Height>360</Height>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
		<!-- conversor de caminhos Windows / macOS -->
		<Extension Id="com.jmbillard.opadeiro.converter">
			<DispatchInfo>
				<Resources>
					<MainPath>./client/converter.html</MainPath>
					<ScriptPath>./host/index.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>O PADEIRO conversor</Menu>
					<Geometry>
						<Size>
							<Width>520</Width>
							<Height>380</Height>
						</Size>
						<MinSize>
							<Width>300</Width>
							<Height>300</Height>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
